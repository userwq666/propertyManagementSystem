# 开发环境配置
NODE_ENV=development

# 应用基础配置
VITE_APP_TITLE=物业管理系统
VITE_APP_BASE_API=/api
VITE_API_BASE_URL=http://localhost:8080

# 接口配置
VITE_API_TIMEOUT=10000

# 代理配置
VITE_PROXY_TARGET=http://localhost:8080

# 本地存储键名
VITE_TOKEN_KEY=Access-Token
VITE_REFRESH_TOKEN_KEY=Refresh-Token
VITE_USER_INFO_KEY=userInfo

# 功能开关
VITE_ENABLE_MOCK=false
VITE_ENABLE_ESLINT=true
VITE_ENABLE_STYLELINT=true

# 打包配置
VITE_OUT_DIR=dist
VITE_SOURCEMAP=false

# 端口配置
VITE_PORT=8081

# Element Plus 配置
VITE_ELEMENT_SIZE=default
VITE_ELEMENT_Z_INDEX=3000

# 图表配置
VITE_ECHARTS_THEME=light